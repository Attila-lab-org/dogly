# Public HTTPS listing URLs. Leave unset until the store listings are live;
# the landing page then renders a disabled "Disponibile presto" CTA.
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/it/app/<app-id>
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=<package-id>

# Canonical public URL used for metadata and Open Graph links.
NEXT_PUBLIC_SITE_URL=https://dogly.example
