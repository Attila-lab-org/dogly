# Dogly Control Center — autenticazione Supabase (obbligatoria).
# Usa SOLO la publishable/anon key. Mai la service-role nel browser o in queste env.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Alternativa legacy (stesso valore):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email autorizzate (virgola/spazio). Fail-closed se vuoto.
ADMIN_ALLOWED_EMAILS=tuo@email.com,altro@email.com
