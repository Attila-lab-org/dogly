{
  "expo": {
    "name": "Dogly",
    "slug": "dogly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dogly",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attilalab.dogly",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Dogly usa la fotocamera per registrare brevi video del tuo cane e aiutarti a capirlo.",
        "NSMicrophoneUsageDescription": "Dogly usa il microfono quando scegli di parlare in tempo reale o registrare un video con audio."
      }
    },
    "android": {
      "package": "com.attilalab.dogly",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#DCEBFE"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#DCEBFE"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dogly usa la fotocamera per registrare brevi video del tuo cane e aiutarti a capirlo.",
          "microphonePermission": "Dogly può usare il microfono durante i video comportamentali. È facoltativo.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Dogly usa il microfono quando scegli di raccontare qualcosa a voce o di registrare un video con audio.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dogly usa le foto che scegli per creare storie e album.",
          "cameraPermission": "Dogly usa la fotocamera solo quando scegli di scattare una foto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6061c72f-e31c-44fe-ade3-ac1c1a76bfc1"
      }
    },
    "owner": "attila-lab-di-loredana-guida",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6061c72f-e31c-44fe-ade3-ac1c1a76bfc1"
    }
  }
}
