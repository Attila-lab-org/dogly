{
  "expo": {
    "name": "Dogly",
    "slug": "dogly",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dogly",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.attilalab.dogly"
    },
    "android": {
      "package": "com.attilalab.dogly"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Dogly usa le foto che scegli per creare storie e album.",
          "cameraPermission": "Dogly usa la fotocamera solo quando scegli di scattare una foto."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6061c72f-e31c-44fe-ade3-ac1c1a76bfc1"
      }
    },
    "owner": "attila-lab-di-loredana-guida"
  }
}
