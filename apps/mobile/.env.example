# --- Supabase (valori PUBBLICI, sicuri nel client — sez. 4.1/4.2) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Alternativa legacy (stesso valore anon/publishable):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Backend API (FastAPI su Vercel — Amendment V1.1) ---
# staging = URL della preview deployment Vercel
# prod    = URL del production deployment Vercel
EXPO_PUBLIC_API_URL=https://your-vercel-deployment.vercel.app

# MAI segreti in questo file o in variabili EXPO_PUBLIC_*:
# le chiavi provider AI e i secret class di sez. 4.2 vivono solo
# server-side (Vercel Environment Variables).
