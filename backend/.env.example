# --- Environment ---
# local | staging | production
# staging/production fail-fast: no mock providers, require DB/storage/JWKS/workflow/AI keys.
APP_ENV=local

# --- Supabase Auth (JWT validation) ---
SUPABASE_JWT_ISSUER=https://example-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://example-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=

# --- Supabase project (Storage service role; never ship to mobile) ---
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (SQLAlchemy async via Supabase pooler) ---
DATABASE_URL=

# --- AI provider routing (sez. 4.1 / 14.2 — no model ID hardcoded) ---
OBSERVER_PROVIDER=mock
OBSERVER_MODEL=mock-observer-v0
REASONING_PROVIDER=mock
REASONING_MODEL=mock-reasoner-v0
DIGESTIVE_VISION_PROVIDER=openai
# Production baseline: keep gpt-5-mini until the digestive eval gate passes.
DIGESTIVE_VISION_MODEL=gpt-5-mini
DIGESTIVE_VERIFIER_MODEL=
# Verifier candidate after a passing evaluation: gpt-5.6-sol
# Set rates to the provider's current public USD / 1M token prices whenever
# changing either model. Verifier rates may differ from the vision model.
DIGESTIVE_INPUT_USD_PER_MILLION=0.25
DIGESTIVE_OUTPUT_USD_PER_MILLION=2.0
# DIGESTIVE_VERIFIER_INPUT_USD_PER_MILLION=
# DIGESTIVE_VERIFIER_OUTPUT_USD_PER_MILLION=
OWNER_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
GEMINI_API_KEY=
OPENAI_API_KEY=
# --- Kill switches / daily budget caps (ops, sez. 25 / RUNBOOK) ---
# Kill switches refuse calls inline; budgets are enforced pre-call against
# internal.ai_cost_events (single SUM + advisory lock, per provider role).
# Exceeding a budget fails the event terminally (AI_BUDGET_EXCEEDED, no retry).
# Set a budget to 0 to disable the gate.
AI_KILL_SWITCH=false
OBSERVER_KILL_SWITCH=false
REASONER_KILL_SWITCH=false
DIGESTIVE_VISION_KILL_SWITCH=false
OWNER_TRANSCRIPTION_KILL_SWITCH=false
OBSERVER_BUDGET_USD_PER_DAY=50
REASONER_BUDGET_USD_PER_DAY=50
DIGESTIVE_VISION_BUDGET_USD_PER_DAY=25
OWNER_TRANSCRIPTION_BUDGET_USD_PER_DAY=5

# --- Storage ---
STORAGE_PROVIDER=mock
STORAGE_SIGNED_URL_TTL_SECONDS=600
BEHAVIOR_RAW_BUCKET=behavior-raw

# --- Billing ---
REVENUECAT_WEBHOOK_SECRET=

# --- Async processing (SPEC_AMENDMENT_V1.1) ---
JOB_QUEUE_BACKEND=fake
WORKFLOW_BASE_URL=
WORKER_INTERNAL_TOKEN=local-internal-token

# --- Observability ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Media constraints (sez. 13) ---
MAX_VIDEO_DURATION_MS=20000
MIN_VIDEO_DURATION_MS=5000

# --- Retention (config TTL, sez. 23.2) ---
RAW_MEDIA_TTL_HOURS=24
