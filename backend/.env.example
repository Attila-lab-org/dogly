# --- Environment ---
APP_ENV=local

# --- Supabase Auth (JWT validation) ---
# Issuer of Supabase JWTs, e.g. https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://example-project.supabase.co/auth/v1
# JWKS URL for asymmetric verification (Supabase signing keys endpoint).
SUPABASE_JWKS_URL=https://example-project.supabase.co/auth/v1/.well-known/jwks.json
# Optional audience check (Supabase default: authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# Legacy HS256 shared secret (only if project still uses HS256). Leave empty in new projects.
SUPABASE_JWT_SECRET=

# --- Database (SQLAlchemy async via Supabase pooler) ---
# Leave empty in local mode: the API falls back to in-memory mock repositories.
DATABASE_URL=

# --- AI provider routing (sez. 4.1 / 14.2 — no model ID hardcoded) ---
OBSERVER_PROVIDER=mock
OBSERVER_MODEL=mock-observer-v0
REASONING_PROVIDER=mock
REASONING_MODEL=mock-reasoner-v0
DIGESTIVE_VISION_PROVIDER=mock
DIGESTIVE_VISION_MODEL=mock-digestive-vision-v0

# --- Storage ---
STORAGE_PROVIDER=mock
STORAGE_SIGNED_URL_TTL_SECONDS=600

# --- Billing ---
# RevenueCat webhook shared secret (Authorization header). Required to accept webhooks.
REVENUECAT_WEBHOOK_SECRET=

# --- Async processing (SPEC_AMENDMENT_V1.1) ---
# Queue backend: "fake" (local dev/CI) | "vercel_workflows" (staging/production).
JOB_QUEUE_BACKEND=fake
# Base URL of the Vercel deployment whose internal workflow routes run jobs.
# Required when JOB_QUEUE_BACKEND=vercel_workflows.
WORKFLOW_BASE_URL=

# --- Private worker ingress (task spoof control, sez. 24.1) ---
# Shared internal token authenticating Vercel Workflows -> worker route calls.
# In staging/production set it as a Vercel Environment Variable.
WORKER_INTERNAL_TOKEN=local-internal-token

# --- Media constraints (sez. 13) ---
MAX_VIDEO_DURATION_MS=20000
MIN_VIDEO_DURATION_MS=5000

# --- Retention (config TTL, sez. 23.2) ---
RAW_MEDIA_TTL_HOURS=24
