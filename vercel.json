{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "fastapi",
  "env": {
    "OBSERVER_PROVIDER": "gemini",
    "OBSERVER_MODEL": "gemini-3.8-flash",
    "REASONING_PROVIDER": "openai",
    "REASONING_MODEL": "gpt-5-mini",
    "DIGESTIVE_VISION_PROVIDER": "openai",
    "DIGESTIVE_VISION_MODEL": "gpt-5-mini",
    "OWNER_TRANSCRIPTION_MODEL": "gpt-4o-mini-transcribe"
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/tasks/cron/retention",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/tasks/cron/care-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/tasks/cron/sweep-stuck",
      "schedule": "*/15 * * * *"
    }
  ]
}
